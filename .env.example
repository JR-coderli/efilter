## 是否本地开发环境
IS_LOCAL=true

## PostgreSQL 数据库连接信息
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=risk_engine
DB_SSL_MODE=disable
DB_TIMEZONE=Asia/Shanghai

## Redis 连接信息
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

## 服务端口
APP_PORT=8080

## API Key（开发默认）
API_KEY=risk-engine-dev-key-2026

## IP 数据库下载地址（用于 tools/update-ipdb/update-ipdb.sh 自动更新）
## 请将 YOUR_TOKEN 替换为实际 token
IP2LOCATION_URL=https://www.ip2location.com/download?token=YOUR_TOKEN&file=DB1LITEBINIPV6
IP2PROXY_URL=https://www.ip2location.com/download?token=YOUR_TOKEN&file=PX2LITEBIN

## IP 数据库路径（相对路径，以 risk-engine 工作目录为基准）
IP2LOCATION_PATH=../../binfiles/IP2LOCATION-LITE-DB1.IPV6.BIN/IP2LOCATION-LITE-DB1.IPV6.BIN
IP2PROXY_PATH=../../binfiles/IP2PROXY-LITE-PX2.BIN/IP2PROXY-LITE-PX2.BIN

## 限流配置（QPS 限流：窗口 1 秒，最大请求 2000）
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX_REQUESTS=2000

## 日志级别
LOG_LEVEL=info
